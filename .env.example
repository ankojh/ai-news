# Local OpenAI Codex agents. Uses your saved `codex login` ChatGPT subscription.
# No OpenAI API key is needed. API-key credentials are excluded from child processes.
CODEX_BIN=codex
CODEX_MODEL_AGENT=gpt-6-sol
CODEX_MODEL_FAST=gpt-6-luna
CODEX_REASONING_EFFORT=low

# Public HF Daily Papers reads work without a token. Optional authenticated reads:
HF_TOKEN=

# Optional narration: fill these in from your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# USD per 1,000 characters depends on your plan; leave blank to skip paid audio.
PRICE_TTS_PER_1K_CHARS=

DATABASE_PATH=./data/newsren.db
CACHE_DIR=./data/cache
AUDIO_DIR=./data/audio
# Generated in your local .env; leave this template blank.
ADMIN_TOKEN=
MAX_CANDIDATES=60
MAX_PAPERS_PER_RUN=10
MAX_TOOL_CALLS_PER_PAPER=8
MAX_TOOL_CALLS_EDITOR=20
# Codex reports token usage after a response; caps are checked between calls.
MAX_TOKENS_PER_PAPER=60000
MAX_TOKENS_PER_RUN=200000
# Applies only to separately billed external APIs (optional narration).
MAX_COST_USD_PER_RUN=1.00
RUN_TIMEOUT_MS=900000
RESEARCH_TIMEOUT_MS=120000
RESEARCH_CONCURRENCY=3
MAX_TTS_CHARS=2500
HN_LOOKBACK_HOURS=48
HF_MIN_CANDIDATES=20
# Optional: your real contact email for the arXiv User-Agent.
CONTACT_EMAIL=
REVIEW_MODE=personal
BRIEFING_AUDIENCE=professional
BRIEFING_SIZE=5
