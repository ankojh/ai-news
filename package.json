{
  "name": "the-newsren",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "daily": "node --env-file-if-exists=.env --import tsx scripts/run-daily.ts",
    "capture-fixtures": "node --env-file-if-exists=.env --import tsx scripts/capture-fixtures.ts",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "demo:clear": "node --env-file-if-exists=.env --import tsx scripts/demo-clear.ts",
    "metrics": "node --import tsx scripts/export-metrics.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "cheerio": "latest",
    "dotenv": "latest",
    "fast-xml-parser": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "type": "module"
}
